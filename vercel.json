{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/projects",
      "destination": "/public/projects.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/public/project-detail.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
