{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/projects/(.+)",
      "destination": "/project-detail.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    }
  ]
}
